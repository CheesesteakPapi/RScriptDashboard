{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete Axon EvidenceCreated report acquisition",
  "type": "object",
  "required": ["schema_version", "report_type", "from_date", "to_date", "page_size", "pages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "report_type": {"const": "EvidenceCreated"},
    "from_date": {"type": "string", "format": "date"},
    "to_date": {"type": "string", "format": "date"},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 50},
    "sample_data": {"type": "boolean"},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["page_offset", "data"], "additionalProperties": false,
        "properties": {
          "page_offset": {"type": "integer", "minimum": 0},
          "data": {"type": "array", "maxItems": 50, "items": {"$ref": "axon-report-page.schema.json#/properties/data/items"}}
        }
      }
    }
  }
}
