// Create each measure separately in the semantic model.
// Uncategorized has one row per valid, eligible, uncategorized Evidence ID.
// Snapshot is a disconnected one-row refresh/status table, not another fact table.
// Report-prefixed measure names avoid collisions with workbook/model columns.

Report Total Uncategorized Items = COALESCE(COUNTA('Uncategorized'[Evidence ID]), 0)

Report Critical Items =
    COALESCE(CALCULATE(COUNTROWS('Uncategorized'), KEEPFILTERS('Uncategorized'[Age Band] = "Critical")), 0)

Report Moderate Items =
    COALESCE(CALCULATE(COUNTROWS('Uncategorized'), KEEPFILTERS('Uncategorized'[Age Band] = "Moderate")), 0)

Report Normal Items =
    COALESCE(CALCULATE(COUNTROWS('Uncategorized'), KEEPFILTERS('Uncategorized'[Age Band] = "Normal")), 0)

Report Oldest Days Since Upload = COALESCE(MAX('Uncategorized'[Days Since Upload]), 0)

Report Average Days Since Upload = AVERAGE('Uncategorized'[Days Since Upload])

Report Snapshot Date = MAX('Snapshot'[Snapshot Date])

Report Creation From Date = MAX('Snapshot'[Creation From Date])

Report Creation To Date = MAX('Snapshot'[Creation To Date])

Report Rejected Source Rows = COALESCE(SUM('Snapshot'[Rejected Rows]), 0)

Report Data Mode = IF(SELECTEDVALUE('Snapshot'[Sample Data], FALSE()), "SYNTHETIC DEMO DATA", "Production data")

Report Age Band Color = SELECTEDVALUE('Uncategorized'[Age Band Color], "#243746")

Report Updated Through UTC = SELECTEDVALUE('Snapshot'[Updated Through UTC])
